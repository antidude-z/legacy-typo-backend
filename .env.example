# Default local mode; creates backend/typography.db when run outside Compose.
DATABASE_URL=sqlite:///./data/typography.db
SESSION_SECRET=replace-with-a-local-secret
SESSION_COOKIE=laravel_session
SESSION_SECURE=false
REMEMBER_DAYS=30
RESET_TOKEN_MINUTES=60
# Use file for local development (writes .eml files under data/mail) or smtp.
RESET_MAIL_MODE=disabled
RESET_MAIL_DIR=./data/mail
APP_URL=http://localhost:5173
# SMTP mode only:
# MAIL_HOST=smtp.example.test
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=typography@example.test

# Later, with the Compose mysql profile enabled:
# DATABASE_URL=mysql+pymysql://typography:typography@mysql:3306/typography